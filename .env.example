# Supabase — te vinden in het Supabase dashboard onder Project Settings > API.
# Kies bij het aanmaken van het project een EU-regio (Frankfurt of Ierland) i.v.m. de AVG.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Web push (PWA). Genereer een sleutelpaar met:  npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=BJ...

# Alleen als secret in Supabase zetten, NOOIT in de app-bundel:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:info@voedselbankhaarlemmermeer.nl
